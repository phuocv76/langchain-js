# ---------------------------------------------------------------------------
# Environment is configured per app — not in this repo root.
# ---------------------------------------------------------------------------
#
# BFF runtime (Hono + CopilotKit + in-process agents):
#   cp apps/bff/.env.example apps/bff/.env
#
# Web frontend (Vite + React + CopilotKit chat):
#   cp apps/web/.env.example apps/web/.env
#
# Optional realtime sync:
#   cp apps/realtime-worker/.dev.vars.sample apps/realtime-worker/.dev.vars
#
# See apps/bff/README.md and apps/web/README.md for variable details.
