# ---------------------------------------------------------------------------
# Environment is configured per app — not in this repo root.
# ---------------------------------------------------------------------------
#
# Space agent server (Hono + CopilotKit + in-process LangGraph):
#   cp apps/space-agent/.env.example apps/space-agent/.env
#
# Kitchen agent server (skeleton):
#   cp apps/kitchen-agent/.env.example apps/kitchen-agent/.env
#
# Optional realtime sync (per product env):
#   cp workers/realtime-worker/.dev.vars.sample workers/realtime-worker/.dev.vars.space
#
# The web frontend lives in its own repository (langchain-copilot-web) with
# its own .env. See each app's README for variable details.
