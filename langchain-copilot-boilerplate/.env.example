# ---------------------------------------------------------------------------
# Shared environment for all apps in the monorepo.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- LLM provider (agent) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Agent runtime ---
# Port the Hono server (CopilotKit runtime + REST) listens on.
AGENT_PORT=4000
# URL of the LangGraph dev server the CopilotKit runtime proxies to.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js, build/runtime public vars) ---
# Where the browser sends CopilotKit requests (the agent's runtime endpoint).
NEXT_PUBLIC_COPILOT_RUNTIME_URL=http://localhost:4000/copilotkit
# Must match the graph id registered in apps/agent/langgraph.json.
NEXT_PUBLIC_AGENT_ID=defaultAgent

# --- Optional: CopilotKit Enterprise Intelligence (durable chat history) ---
# Sign in at https://dashboard.operations.copilotkit.ai then run:
#   npx copilotkit@latest project select
# The CLI writes the Intelligence URLs + API key below and creates .copilotkit/project.json.
#
# COPILOTKIT_LICENSE_TOKEN=         # server license (from dashboard)
# INTELLIGENCE_API_URL=             # e.g. https://api… (cloud) or http://localhost:4201 (local stack)
# INTELLIGENCE_GATEWAY_WS_URL=      # e.g. wss://… (cloud) or ws://localhost:4401 (local stack)
# INTELLIGENCE_API_KEY=cpk_…        # project-scoped runtime key — server only, never expose to the browser
# INTELLIGENCE_DEV_USER_ID=local-dev-user
# NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=  # public license key for the web app

# --- Optional: observability (LangSmith) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-copilot-boilerplate
