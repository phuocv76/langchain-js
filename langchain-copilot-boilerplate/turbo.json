{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "OPENAI_REASONING_EFFORT",
    "OPENAI_MAX_OUTPUT_TOKENS",
    "OPENAI_REQUEST_TIMEOUT_MS",
    "OPENAI_MAX_RETRIES",
    "AGENT_PORT",
    "CORS_ORIGINS",
    "ALLOWED_EMAIL_DOMAINS",
    "FIREBASE_PROJECT_ID",
    "API_BASE_URL",
    "API_TIMEOUT_MS",
    "MEMORY_WORKER_URL",
    "CF_ACCESS_CLIENT_ID",
    "CF_ACCESS_CLIENT_SECRET",
    "REALTIME_WORKER_URL",
    "REALTIME_PUBLISH_SECRET",
    "COPILOTKIT_TELEMETRY_DISABLED",
    "COPILOTKIT_LICENSE_TOKEN",
    "LANGSMITH_TRACING",
    "LANGSMITH_API_KEY",
    "LANGSMITH_PROJECT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Internal packages export TypeScript source (just-in-time packages),
    // so lint/typecheck/test need no upstream build artifacts.
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    }
  }
}
