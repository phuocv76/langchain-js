{
  "name": "@repo/memory-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env offline --port 8788 --inspector-port 9230",
    "dev:offline": "wrangler dev --env offline --port 8788 --inspector-port 9230",
    "deploy": "wrangler deploy",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 migrations apply agent-memory --local --env offline",
    "db:clear:local": "bash scripts/clear-local-d1.sh",
    "db:apply:remote": "wrangler d1 migrations apply agent-memory --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260320.0",
    "@repo/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.67.0"
  }
}
