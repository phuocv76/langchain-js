{
  "name": "@repo/memory-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env space-offline --port 8788 --inspector-port 9230",
    "dev:space": "wrangler dev --env space-offline --port 8788 --inspector-port 9230",
    "dev:kitchen": "wrangler dev --env kitchen-offline --port 8790 --inspector-port 9231",
    "deploy:space": "wrangler deploy --env space",
    "deploy:kitchen": "wrangler deploy --env kitchen",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:apply:local:space": "wrangler d1 migrations apply agent-memory --local --env space-offline",
    "db:apply:remote:space": "wrangler d1 migrations apply agent-memory --remote --env space",
    "db:apply:local:kitchen": "wrangler d1 migrations apply kitchen-agent-memory --local --env kitchen-offline",
    "db:apply:remote:kitchen": "wrangler d1 migrations apply kitchen-agent-memory --remote --env kitchen",
    "db:clear:local:space": "bash scripts/clear-local-d1.sh space-offline agent-memory",
    "db:clear:local:kitchen": "bash scripts/clear-local-d1.sh kitchen-offline kitchen-agent-memory"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
