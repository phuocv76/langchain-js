# ---------------------------------------------------------------------------
# @repo/web environment
# Copy to `.env` in this directory: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- CopilotKit frontend ---
# Where the browser sends CopilotKit requests (the agent's runtime endpoint).
NEXT_PUBLIC_COPILOT_RUNTIME_URL=http://localhost:4000/copilotkit
# Must match the graph id registered in apps/agent/langgraph.json.
NEXT_PUBLIC_AGENT_ID=defaultAgent

# --- CopilotKit Intelligence (required for durable chat history in the sidebar) ---
# Get the public license key from https://dashboard.operations.copilotkit.ai
# (starts with ck_pub_). Server-side Intelligence vars belong in apps/agent/.env.
# NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=ck_pub_…

# --- Firebase Authentication (Google Sign-In) ---
# Create a Firebase project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Google.
# Add http://localhost:3000 to authorized domains for local dev.
#
# Web client config (Project settings → General → Your apps → Web app):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_APP_ID=
#
# Admin SDK service account (Project settings → Service accounts → Generate new private key):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
