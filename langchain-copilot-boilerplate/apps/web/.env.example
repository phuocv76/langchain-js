# ---------------------------------------------------------------------------
# @repo/web environment
# Copy to `.env` in this directory: `cp .env.example .env`
# All values here are VITE_* — they are inlined into the browser bundle.
# Never put server secrets in this file.
# ---------------------------------------------------------------------------

# --- BFF runtime (called directly by the browser) ---
# CopilotKit runtime endpoint on the BFF. Add this app's origin
# (http://localhost:3000) to CORS_ORIGINS in apps/bff/.env.
VITE_COPILOT_RUNTIME_URL=http://localhost:4000/copilotkit
# Must match the agent id registered in apps/agent graphs/registry.
VITE_AGENT_ID=workspaceAgent

# --- Optional realtime sync (apps/realtime-worker) ---
# Leave unset to disable. Local: `pnpm --filter @repo/realtime-worker dev`
# VITE_REALTIME_WS_URL=ws://localhost:8789/ws

# --- Firebase Authentication (Google Sign-In) ---
# Create a Firebase project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Google.
# Add http://localhost:3000 to authorized domains for local dev.
# Use the SAME project as FIREBASE_PROJECT_ID in apps/bff/.env — the BFF
# verifies the ID tokens this app sends.
#
# Web client config (Project settings → General → Your apps → Web app):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=
