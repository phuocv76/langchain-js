# ---------------------------------------------------------------------------
# @repo/web environment
# Copy to `.env` in this directory: `cp .env.example .env`
# All values here are NEXT_PUBLIC_* — they are inlined into the browser
# bundle. Never put server secrets in this file.
# ---------------------------------------------------------------------------

# --- Agent runtime (called directly by the browser) ---
# CopilotKit runtime endpoint on the agent service. Add this app's origin
# (http://localhost:3000) to CORS_ORIGINS in apps/agent/.env.
NEXT_PUBLIC_COPILOT_RUNTIME_URL=http://localhost:4000/copilotkit
# Must match the graph id registered in apps/agent/langgraph.json.
NEXT_PUBLIC_AGENT_ID=workspaceAgent

# --- Firebase Authentication (Google Sign-In) ---
# Create a Firebase project at https://console.firebase.google.com
# Enable Authentication → Sign-in method → Google.
# Add http://localhost:3000 to authorized domains for local dev.
# Use the SAME project as FIREBASE_PROJECT_ID in apps/agent/.env — the agent
# verifies the ID tokens this app sends.
#
# Web client config (Project settings → General → Your apps → Web app):
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_APP_ID=
