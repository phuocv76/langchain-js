{
  "name": "@repo/space-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space product agent server: workspace graphs, tools, and agent registry over the shared @repo/agent-runtime composition.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node --env-file=.env dist/server.js",
    "studio": "langgraphjs dev --port 2024 --no-browser",
    "lint": "eslint .",
    "test": "tsx --env-file=.env --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "regression:harness:embed": "tsx --env-file=.env src/regression/embed-server-harness.ts",
    "regression:harness:gateway": "tsx --env-file=.env src/regression/copilotkit-gateway-harness.ts",
    "regression:chat-flow": "tsx --env-file=.env src/regression/chat-flow-check.ts",
    "regression:hitl": "tsx --env-file=.env src/regression/hitl-tools-check.ts",
    "regression:trusted-context": "tsx --env-file=.env src/regression/trusted-context-check.ts",
    "regression:summary-parity": "tsx --env-file=.env src/regression/summary-parity-check.ts",
    "regression:embed-api": "tsx --env-file=.env src/regression/embed-api-check.ts",
    "regression:resume-agent": "tsx --env-file=.env src/regression/resume-agent-check.ts"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@ag-ui/core": "catalog:",
    "@ag-ui/langgraph": "catalog:",
    "@copilotkit/runtime": "catalog:",
    "@copilotkit/sdk-js": "catalog:",
    "@hono/node-server": "catalog:",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@langchain/langgraph-api": "catalog:",
    "@repo/agent-runtime": "workspace:*",
    "@repo/prompts": "workspace:*",
    "@repo/shared": "workspace:*",
    "hono": "catalog:",
    "langchain": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.3.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
