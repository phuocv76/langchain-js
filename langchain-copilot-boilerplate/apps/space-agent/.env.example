# ---------------------------------------------------------------------------
# @repo/bff environment
# Copy to `.env` in this directory: `cp .env.example .env`
# Also copy (or symlink) into `apps/agent/.env` if you run LangGraph Studio.
# ---------------------------------------------------------------------------

# --- LLM provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# Use `medium` or `high` only when the task warrants the extra reasoning time.
OPENAI_REASONING_EFFORT=low
# Bound response generation; increase for deliberately long-form answers.
OPENAI_MAX_OUTPUT_TOKENS=768
# Fail a stalled request promptly and retry only once by default.
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=1

# --- Optional LangGraph Studio ---
# Chat runs graphs in-process via the BFF (D1 checkpoints when MEMORY_WORKER_URL
# is set). Studio is optional: `pnpm --filter @repo/agent studio`
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
# LANGSMITH_API_KEY=

# --- Firebase Auth (required for /copilotkit and /memory) ---
# Same project as VITE_FIREBASE_PROJECT_ID in apps/web/.env. The BFF verifies
# ID tokens with Google JWKS — no Admin private key needed here.
# FIREBASE_PROJECT_ID=your-project-id
# Optional: restrict sign-in to company domains (verified emails only).
# ALLOWED_EMAIL_DOMAINS=asnet.com.vn

# --- Existing product REST API ---
# Agent tools call this API with the signed-in user's Firebase ID token as
# `Authorization: Bearer` (same token the web app uses). Only the base URL is
# required; the BFF forwards the verified token on each run.
# API_BASE_URL=https://api.example.com
# API_TIMEOUT_MS=10000

# --- Durable memory + checkpoints (apps/memory-worker) ---
# Leave MEMORY_WORKER_URL unset to disable durable transcript memory and fall
# back to in-process MemorySaver for graph checkpoints. For local D1:
#   pnpm --filter @repo/memory-worker dev
# MEMORY_WORKER_URL=http://localhost:8788
# Deployed workers sit behind Cloudflare Access, which requires the service
# token pair (both values together):
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# --- Optional realtime sync (apps/realtime-worker) ---
# Leave unset to skip cross-session push. Local:
#   pnpm --filter @repo/realtime-worker dev
# REALTIME_WORKER_URL=http://localhost:8789
# REALTIME_PUBLISH_SECRET=dev-realtime-publish-secret-change-me
# The secret must match REALTIME_PUBLISH_SECRET in the worker's .dev.vars.

# --- BFF runtime ---
# Port the Hono BFF (CopilotKit runtime + REST) listens on.
AGENT_PORT=4000
# Comma-separated list of allowed chat-frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Disable anonymous CopilotKit runtime telemetry if required by your policy.
# COPILOTKIT_TELEMETRY_DISABLED=true
# Optional CopilotKit license / MCP Apps demo server.
# COPILOTKIT_LICENSE_TOKEN=

# --- Optional: observability (LangSmith) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-copilot-boilerplate
