# Kitchen agent server — copy to .env and fill in.
# Each product server runs its own process with its own env; see
# packages/agent-runtime/src/config/env.ts for the full infra schema.

# Port for this product server (space uses 4000).
AGENT_PORT=4100

# OpenAI (required to construct the graph).
OPENAI_API_KEY=

# Firebase project whose ID tokens this server accepts (same project as the
# kitchen frontend's VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=
# Comma-separated email domains allowed to use the assistant (empty = all).
ALLOWED_EMAIL_DOMAINS=

# Frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3100

# Durable memory + checkpoints in D1 via the memory worker. Use the
# kitchen-dedicated local worker so kitchen threads never mix with space:
#   pnpm --filter @repo/memory-worker dev:kitchen   (port 8790)
MEMORY_WORKER_URL=http://localhost:8790
# Cloudflare Access service token pair — deployed workers only.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional cross-session realtime sync. Use the kitchen-dedicated worker env
# so kitchen events never reach space sessions:
#   pnpm --filter @repo/realtime-worker dev:kitchen   (port 8791)
REALTIME_WORKER_URL=
REALTIME_PUBLISH_SECRET=
