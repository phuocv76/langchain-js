# Copy to .env.docker for `pnpm dev:server` (LangGraph server in Docker with
# Postgres-backed checkpoints). Start from your .env values, then apply the
# container-specific changes below. Never commit .env.docker.

# Required by the self-hosted LangGraph server image (free "Lite" license).
# Create a key at https://smith.langchain.com → Settings → API Keys.
LANGSMITH_API_KEY=

# Same as .env.
OPENAI_API_KEY=

# The graph runs INSIDE a container, so "localhost" no longer points at your
# machine. Use host.docker.internal for services running on the host:
API_BASE_URL=http://host.docker.internal:8787
API_SERVICE_TOKEN=
MEMORY_WORKER_URL=http://host.docker.internal:8788

# Same as .env (Firebase Admin verification, optional in dev).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
