# ---------------------------------------------------------------------------
# @repo/agent environment
# Copy to `.env` in this directory: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- LLM provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# Use `medium` or `high` only when the task warrants the extra reasoning time.
OPENAI_REASONING_EFFORT=low
# Bound response generation; increase for deliberately long-form answers.
OPENAI_MAX_OUTPUT_TOKENS=768
# Fail a stalled request promptly and retry only once by default.
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=1

# --- Trusted Firebase identity (required for CopilotKit agent requests) ---
# The Next.js proxy forwards the httpOnly Firebase session cookie only as the
# x-agent-user-token header. Never expose these server credentials to browsers.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare durable memory Worker (all three values are required together) ---
# MEMORY_WORKER_URL=https://memory.example.com
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# --- Agent runtime ---
# Port the Hono server (CopilotKit runtime + REST) listens on.
AGENT_PORT=4000
# URL of the LangGraph dev server the CopilotKit runtime proxies to.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Server-to-server secret shared with the Next.js CopilotKit proxy.
# Required in production; generate at least 32 random characters.
# COPILOT_RUNTIME_SECRET=
# Disable anonymous CopilotKit runtime telemetry if required by your policy.
# COPILOTKIT_TELEMETRY_DISABLED=true

# --- Optional: observability (LangSmith) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-copilot-boilerplate
