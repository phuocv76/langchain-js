{
  "name": "@repo/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangChain + LangGraph agent backend hosting the CopilotKit runtime.",
  "scripts": {
    "dev": "concurrently -n langgraph,api -c magenta,cyan \"pnpm run dev:graph\" \"pnpm run dev:api\"",
    "dev:graph": "langgraphjs dev --port 2024 --no-browser",
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute MEMORY_DB --local --file=migrations/0001_memory.sql --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 execute MEMORY_DB --remote --file=migrations/0001_memory.sql --config wrangler.jsonc",
    "build": "tsup --config tsup.config.ts",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@copilotkit/runtime": "1.62.3",
    "@copilotkit/sdk-js": "1.62.3",
    "@hono/node-server": "^1.19.14",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/openai": "^1.5.5",
    "@repo/prompts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/types": "workspace:*",
    "firebase-admin": "^14.1.0",
    "hono": "^4.12.28",
    "langchain": "^1.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.3.1",
    "@cloudflare/workers-types": "^4.20260320.0",
    "@repo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "tsx": "^4.22.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.67.0"
  }
}
