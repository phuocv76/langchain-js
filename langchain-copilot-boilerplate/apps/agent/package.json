{
  "name": "@repo/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangChain + LangGraph agents served through the BFF's embedded LangGraph platform app with D1 persistence; optional LangGraph Studio via `pnpm studio`.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --eval \"console.log('@repo/agent: graphs run in-process via @repo/bff'); setInterval(() => {}, 1 << 30)\"",
    "studio": "langgraphjs dev --port 2024 --no-browser",
    "lint": "eslint .",
    "test": "tsx --env-file=../bff/.env --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/langgraph": "0.0.42",
    "@copilotkit/runtime": "1.62.3",
    "@copilotkit/sdk-js": "1.62.3",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-api": "1.4.3",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "@repo/prompts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/types": "workspace:*",
    "hono": "^4.12.28",
    "jose": "^6.2.3",
    "langchain": "^1.5.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.14",
    "@langchain/langgraph-cli": "^1.3.1",
    "@repo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.17.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
