{
  "name": "@repo/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangChain + LangGraph agent backend hosting the CopilotKit runtime.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@copilotkit/runtime": "1.62.3",
    "@copilotkit/sdk-js": "1.62.3",
    "@hono/node-server": "^1.19.14",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "@repo/prompts": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/types": "workspace:*",
    "firebase-admin": "^14.1.0",
    "hono": "^4.12.28",
    "langchain": "^1.5.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.17.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
