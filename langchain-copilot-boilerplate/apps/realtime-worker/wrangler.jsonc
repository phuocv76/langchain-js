{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanchain-boilerplate-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "LANCHAIN_BOILERPLATE_HUB",
        "class_name": "LanchainBoilerplateHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LanchainBoilerplateHub"]
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://langchain-js.pages.dev"
  }
}
