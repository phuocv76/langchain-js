# ---------------------------------------------------------------------------
# @repo/bff environment
# Copy to `.env` in this directory: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- LLM provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini
# Use `medium` or `high` only when the task warrants the extra reasoning time.
OPENAI_REASONING_EFFORT=low
# Bound response generation; increase for deliberately long-form answers.
OPENAI_MAX_OUTPUT_TOKENS=768
# Fail a stalled request promptly and retry only once by default.
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=1

# --- End-user verification (required in production) ---
# The chat frontend sends the user's Firebase ID token as `Authorization:
# Bearer`; this BFF verifies it directly.
# Never expose these server credentials to browsers.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Restrict access to verified accounts on these email domains
# (comma-separated). Leave unset to allow every verified account.
# ALLOWED_EMAIL_DOMAINS=asnet.com.vn

# --- Existing product REST API (both values are required together) ---
# Agent tools call this API with the service token and acting-user headers
# (X-Acting-User-Id / X-Acting-User-Email / X-Request-Id). The token must
# equal the API's AGENT_SERVICE_TOKEN wrangler secret.
# API_BASE_URL=https://api.example.com
# API_SERVICE_TOKEN=
# API_TIMEOUT_MS=10000

# --- Optional durable memory service (apps/memory-worker) ---
# Leave MEMORY_WORKER_URL unset to disable durable transcript memory (the
# middleware then no-ops). For local dev, run `pnpm --filter @repo/memory-worker dev`
# and point at it directly — no Access credentials needed:
# MEMORY_WORKER_URL=http://localhost:8788
# Deployed workers sit behind Cloudflare Access, which requires the service
# token pair (both values together):
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# --- Optional realtime sync (apps/realtime-worker) ---
# Leave unset to skip cross-session push. Local:
#   pnpm --filter @repo/realtime-worker dev
# REALTIME_WORKER_URL=http://localhost:8789
# REALTIME_PUBLISH_SECRET=dev-realtime-publish-secret-change-me
# The secret must match REALTIME_PUBLISH_SECRET in the worker's .dev.vars.

# --- BFF runtime ---
# Port the Hono BFF (CopilotKit runtime + REST) listens on.
# Agents run in-process via @repo/agent; short-term memory (checkpoints)
# lives in D1 behind MEMORY_WORKER_URL above.
AGENT_PORT=4000
# Comma-separated list of allowed chat-frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Disable anonymous CopilotKit runtime telemetry if required by your policy.
# COPILOTKIT_TELEMETRY_DISABLED=true

# --- Optional: observability (LangSmith) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-copilot-boilerplate
