{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanchain-boilerplate-memory-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "d1_databases": [
    {
      "binding": "MEMORY_DB",
      "database_name": "langchain-boilerplate-agent-memory",
      "database_id": "6979d0bd-8845-45f5-881a-eb8cd202b51a"
    }
  ],
  "vectorize": [
    {
      "binding": "MEMORY_INDEX",
      "index_name": "agent-memory"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "env": {
    // Local-only profile for `pnpm dev:offline`: the AI binding always proxies
    // to Cloudflare (needs `wrangler login`) and Vectorize has no local mode,
    // so this env drops both and the Worker degrades to recent-turn recall.
    // Never deploy this env.
    "offline": {
      "vars": {
        "REQUIRE_CF_ACCESS": "false"
      },
      "d1_databases": [
        {
          "binding": "MEMORY_DB",
          "database_name": "agent-memory",
          "database_id": "replace-with-your-d1-database-id"
        }
      ]
    }
  }
}
