{
  "name": "langchain-copilot-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "description": "Agent runtime boilerplate: BFF (Hono + CopilotKit) + LangGraph agents with tools for an existing REST API.",
  "scripts": {
    "dev": "turbo run dev",
    "dev:bff": "turbo run dev --filter=@repo/bff",
    "dev:agent": "turbo run dev --filter=@repo/agent",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:realtime": "turbo run dev --filter=@repo/realtime-worker",
    "deploy:realtime": "pnpm --filter @repo/realtime-worker deploy",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
