OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
USER_API_URL=http://localhost:4000
BACKEND_PORT=4000
DATABASE_PATH=./data/user-management.db

# Production (set before `pnpm deploy:frontend` build)
# VITE_BACKEND_URL=https://user-management-backend.<account>.workers.dev
# VITE_USER_API_URL=https://user-management-backend.<account>.workers.dev
# VITE_COPILOTKIT_RUNTIME_URL=https://user-management-backend.<account>.workers.dev/api/copilotkit

# Cloudflare Worker secrets (set via `wrangler secret put`)
# OPENAI_API_KEY — required on backend worker for RAG
# LANGGRAPH_DEPLOYMENT_URL — required on backend worker (public LangGraph URL)

# Backend worker var (wrangler.jsonc [vars] or dashboard)
# CORS_ORIGINS=https://user-management-app.pages.dev
