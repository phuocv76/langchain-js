{
  "name": "@repo/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono backend — REST API, auth, RAG, and CopilotKit runtime.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:cf": "wrangler dev --port 4000 --env-file ../../.env",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:apply:local:cf": "wrangler d1 migrations apply user-management-db --local",
    "db:apply:remote": "wrangler d1 migrations apply user-management-db --remote"
  },
  "dependencies": {
    "@copilotkit/runtime": "1.61.1",
    "@hono/node-server": "^1.19.14",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250613.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.22.0"
  }
}
