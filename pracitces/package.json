{
  "name": "email-agent-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "description": "LangChain + LangGraph practice: read and reply to email with human-in-the-loop.",
  "scripts": {
    "cli": "tsx src/main.ts",
    "gmail:token": "node scripts/get-gmail-token.mjs",
    "typecheck": "tsc --noEmit",
    "dev:agent": "langgraphjs dev",
    "dev:web": "pnpm -C web dev",
    "dev": "concurrently -n agent,web -c blue,green \"pnpm run dev:agent\" \"pnpm run dev:web\""
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/openai": "^1.5.1",
    "@octokit/rest": "^22.0.1",
    "googleapis": "^173.0.0",
    "langchain": "^1.5.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@copilotkit/sdk-js": "^1.61.0",
    "@langchain/langgraph-cli": "^1.3.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.5"
  }
}
