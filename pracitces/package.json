{
  "name": "langchain-langgraph-practices",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Practice exercises for LangChain.js and LangGraph.js (TypeScript, OpenAI).",
  "workspaces": ["web"],
  "scripts": {
    "exercise": "tsx",
    "new": "node scripts/new-exercise.mjs",
    "gmail:token": "node scripts/get-gmail-token.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev:agent": "langgraphjs dev",
    "dev:web": "npm --workspace web run dev",
    "dev": "concurrently -n agent,web -c blue,green \"npm run dev:agent\" \"npm run dev:web\""
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/openai": "^1.5.1",
    "@octokit/rest": "^22.0.1",
    "googleapis": "^173.0.0",
    "langchain": "^1.5.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@copilotkit/sdk-js": "^1.61.0",
    "@langchain/langgraph-cli": "^1.3.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.5"
  }
}
