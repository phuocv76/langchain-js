# Copy this file to ".env" and fill in your key.
OPENAI_API_KEY=sk-...

# Optional: default model used by src/lib/model.ts
OPENAI_MODEL=gpt-4o-mini

# Optional: enable LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=langchain-practices

# --- Gmail (Read Email + Send Reply) ---
# Create an OAuth 2.0 "Desktop app" client in Google Cloud Console, enable the
# Gmail API, then run: pnpm gmail:token  to mint GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The mailbox to read/send from (usually "me" or your address).
GMAIL_USER=me

# --- GitHub Issues (Bug Track) ---
# Personal access token with "issues" (repo) scope.
GITHUB_TOKEN=
# Target repository in "owner/repo" form.
GITHUB_REPO=

# --- Doc Search ---
# Folder of markdown/text files indexed into the vector store.
DOCS_DIR=docs

# --- CLI (pnpm cli) ---
# Set to "true" to auto-approve draft replies without a terminal prompt.
# AUTO_APPROVE=true

# --- CopilotKit / LangGraph dev server (pnpm dev) ---
# URL of the local `langgraphjs dev` server.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
