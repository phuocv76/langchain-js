# Copy this file to ".env" and fill in your key.
OPENAI_API_KEY=sk-...

# Optional: default model used by apps/agent/src/lib/model.ts
OPENAI_MODEL=gpt-4o-mini

# Optional: enable LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=langchain-practices

# --- Gmail (Read Email + Send Reply) ---
# Create an OAuth 2.0 "Desktop app" client in Google Cloud Console, enable the
# Gmail API, then run: pnpm gmail:token  to mint GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The mailbox to read/send from (usually "me" or your address).
GMAIL_USER=me

# --- GitHub Issues (Bug Track) ---
# Personal access token with "issues" (repo) scope.
GITHUB_TOKEN=
# Target repository in "owner/repo" form.
GITHUB_REPO=

# --- Doc Search ---
# Folder of markdown/text files indexed into the vector store.
DOCS_DIR=docs

# --- News Agent (optional Tavily search) ---
# When set, search_news uses Tavily; otherwise Hacker News Algolia fallback.
# TAVILY_API_KEY=

# --- Warranty Agent RAG ---
WARRANTY_DOCS_DIR=docs/warranty

# --- CLI (pnpm cli) ---
# Set to "true" to auto-approve draft replies without a terminal prompt.
# AUTO_APPROVE=true

# --- CopilotKit / LangGraph dev server (pnpm dev) ---
# URL of the local `langgraphjs dev` server.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024

# Points at the running BFF (apps/bff)
COPILOTKIT_RUNTIME_URL=http://localhost:4000/api/copilotkit

# --- CopilotKit Intelligence (optional — enables saved chat history) ---
# All three CLI values are required together. A key alone breaks agent runs.
# Provision them with:
#   npx copilotkit@latest project select
# Loaded from repo root `.env`. Restart `pnpm dev` after changes.
#
# CLI names (required together):
# INTELLIGENCE_API_URL=https://...
# INTELLIGENCE_GATEWAY_WS_URL=wss://...
# INTELLIGENCE_API_KEY=cpk_...
#
# Manual aliases (same values):
# COPILOTKIT_INTELLIGENCE_API_URL=
# COPILOTKIT_INTELLIGENCE_WS_URL=
# COPILOTKIT_INTELLIGENCE_API_KEY=
